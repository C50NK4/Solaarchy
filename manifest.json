{
  "schemaVersion": 1,
  "id": "io.github.c50nk4.solaarchy",
  "name": "Solaarchy",
  "version": "1.1.0",
  "author": "C50NK4",
  "license": "MIT",
  "description": "Every connected Logitech device at a glance in the Omarchy bar: battery per device, live connect and disconnect, low-battery alerts, the keyboard backlight and mouse haptics, read through Solaar.",
  "homepage": "https://github.com/C50NK4/Solaarchy",
  "repository": "https://github.com/C50NK4/Solaarchy",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Solaarchy",
    "description": "Battery, backlight and haptics for your Logitech devices at a glance, via Solaar. Left-click: panel. Right-click: keyboard backlight. Middle-click: open Solaar.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "icon": "solaar",
      "customIcon": "",
      "customIconDir": "",
      "refreshIntervalSec": 300,
      "lowThreshold": 15,
      "hideWhenDisconnected": true,
      "hapticLowBattery": "angry-alert",
      "hapticNotifications": "off",
      "hapticNotificationsCritical": "sharp-state-change",
      "hapticNotificationApps": "",
      "hapticUrgent": "sharp-collision",
      "hapticBell": "whisper-collision",
      "hapticWorkspace": "off",
      "hapticWindowOpen": "off",
      "hapticWindowClose": "off",
      "hapticWindowMoved": "off",
      "hapticFullscreen": "off",
      "hapticFloating": "off",
      "hapticScreencast": "off",
      "hapticMonitor": "off",
      "hapticSubmap": "off",
      "hapticLayout": "off",
      "hapticPauseFullscreen": false
    },
    "schema": [
      {
        "key": "icon",
        "type": "enum",
        "label": "Bar icon",
        "options": [
          "solaar",
          "mouse",
          "keyboard",
          "combo",
          "mouse-outline",
          "keyboard-outline",
          "combo-outline"
        ],
        "defaultValue": "solaar",
        "description": "solaar, or a device icon: mouse, keyboard, combo, each also as -outline. To use your own artwork instead, see customIcon."
      },
      {
        "key": "customIcon",
        "type": "string",
        "label": "Custom bar icon",
        "defaultValue": "",
        "description": "File name of an SVG in the custom icon folder, without the .svg (for example: my-logo). Overrides the bar icon above while set. Solaarchy ships no vendor logos, so this is how you use your own."
      },
      {
        "key": "customIconDir",
        "type": "path",
        "label": "Custom icon folder",
        "defaultValue": "",
        "description": "Folder scanned for custom bar icons. Defaults to ~/.config/omarchy/solaarchy/icons."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "description": "Backup poll. Connects, disconnects and receiver plugging update right away; each poll wakes the receiver, so keep this relaxed.",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      },
      {
        "key": "lowThreshold",
        "type": "integer",
        "label": "Low battery threshold (%)",
        "description": "Below this the icon turns urgent and one notification is sent per discharge.",
        "min": 5,
        "max": 50,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide when no receiver",
        "description": "Hide the widget while no Logitech receiver or device is connected. It reappears when one is plugged in.",
        "defaultValue": true
      },
      {
        "key": "hapticLowBattery",
        "type": "enum",
        "label": "Haptic: low battery",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "angry-alert",
        "description": "Waveform played on the device with haptics when Solaarchy sends its low-battery notification."
      },
      {
        "key": "hapticNotifications",
        "type": "enum",
        "label": "Haptic: notifications",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform for every desktop notification. While any notification haptic is on (critical ones are by default), Solaarchy watches the session bus for the sender's app name and urgency, never the text."
      },
      {
        "key": "hapticNotificationsCritical",
        "type": "enum",
        "label": "Haptic: critical notifications",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "sharp-state-change",
        "description": "Waveform for critical-urgency notifications, played instead of the one above."
      },
      {
        "key": "hapticNotificationApps",
        "type": "string",
        "label": "Haptic: per-app notifications",
        "defaultValue": "",
        "description": "Per-app waveforms, overriding the two above: app=waveform, comma-separated, e.g. slack=knock, spotify=off. Use the app name the notification is sent with."
      },
      {
        "key": "hapticUrgent",
        "type": "enum",
        "label": "Haptic: window wants attention",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "sharp-collision",
        "description": "Waveform when a window asks for attention (Hyprland urgent)."
      },
      {
        "key": "hapticBell",
        "type": "enum",
        "label": "Haptic: terminal bell",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "whisper-collision",
        "description": "Waveform for the system bell, e.g. a terminal ringing it (Hyprland bell)."
      },
      {
        "key": "hapticWorkspace",
        "type": "enum",
        "label": "Haptic: workspace switch",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when the active workspace changes."
      },
      {
        "key": "hapticWindowOpen",
        "type": "enum",
        "label": "Haptic: window opened",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when a window opens."
      },
      {
        "key": "hapticWindowClose",
        "type": "enum",
        "label": "Haptic: window closed",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when a window closes."
      },
      {
        "key": "hapticWindowMoved",
        "type": "enum",
        "label": "Haptic: window moved to workspace",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when a window is sent to another workspace."
      },
      {
        "key": "hapticFullscreen",
        "type": "enum",
        "label": "Haptic: fullscreen",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when the focused window enters or leaves fullscreen."
      },
      {
        "key": "hapticFloating",
        "type": "enum",
        "label": "Haptic: floating",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when a window is toggled between tiled and floating."
      },
      {
        "key": "hapticScreencast",
        "type": "enum",
        "label": "Haptic: screen sharing",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when screen sharing or recording starts and stops."
      },
      {
        "key": "hapticMonitor",
        "type": "enum",
        "label": "Haptic: monitor",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when a monitor is connected or disconnected."
      },
      {
        "key": "hapticSubmap",
        "type": "enum",
        "label": "Haptic: submap",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when a keybind submap is entered or left."
      },
      {
        "key": "hapticLayout",
        "type": "enum",
        "label": "Haptic: keyboard layout",
        "options": [
          "off",
          "sharp-state-change",
          "damp-state-change",
          "sharp-collision",
          "damp-collision",
          "subtle-collision",
          "whisper-collision",
          "happy-alert",
          "angry-alert",
          "completed",
          "knock",
          "square",
          "wave",
          "firework",
          "mad",
          "jingle",
          "ringing"
        ],
        "defaultValue": "off",
        "description": "Waveform when the keyboard layout switches."
      },
      {
        "key": "hapticPauseFullscreen",
        "type": "boolean",
        "label": "Haptic: quiet in fullscreen",
        "defaultValue": false,
        "description": "No Hyprland event haptics while the focused workspace has a fullscreen window, such as a game or a video. Notifications and low battery still buzz."
      }
    ]
  }
}
